# Public API base URL of the NestJS backend.
#
# This value is INLINED INTO THE JAVASCRIPT BUNDLE AT BUILD TIME
# (`next build`) because it is prefixed with NEXT_PUBLIC_. For a static export
# that means you must set it in the Netlify UI before the build runs:
#
#   Netlify -> Project configuration -> Environment variables -> Add a variable
#   Key:   NEXT_PUBLIC_API_URL
#   Value: https://workshop-registration-api.onrender.com
#   Scope: tick "Builds" (a static export needs it while building)
#
# Then redeploy with "Clear cache and deploy site" - changing the variable alone
# does not rebuild the bundle.
#
# `frontend/next.config.ts` fails the Netlify build (NETLIFY=true) when this
# value is missing or still points at localhost, and prints the value it did use
# at the top of every build log.
NEXT_PUBLIC_API_URL="http://localhost:3001"
