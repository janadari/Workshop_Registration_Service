# Public API base URL of the NestJS backend.
#
# This value is INLINED INTO THE JAVASCRIPT BUNDLE AT BUILD TIME
# (`next build`) because it is prefixed with NEXT_PUBLIC_. For a static export
# that means you must set it in the Netlify UI before the build runs:
#
#   Site configuration -> Environment variables
#   NEXT_PUBLIC_API_URL = https://workshop-registration-api.onrender.com
#
# If it is missing during a Netlify build, the app falls back to
# http://localhost:3001 and every request from the deployed site fails.
NEXT_PUBLIC_API_URL="http://localhost:3001"
