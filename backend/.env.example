# Backend environment variables.
# Copy this file to `.env` for local development.

# Postgres connection strings (Neon Console -> Connect -> copy BOTH strings).
#   DATABASE_URL -> pooled connection string (used at runtime; host contains "-pooler")
#   DIRECT_URL   -> direct connection string (used by `prisma migrate`)
# `connect_timeout=15` is recommended on Neon: computes scale to zero when idle
# and the first query can otherwise time out while it wakes up.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET="change-me"

# Port the server listens on. Render injects its own PORT automatically.
PORT=3001

# Optional. Comma-separated list of browser origins allowed to call the API.
# Leave unset to allow every origin (the default).
# CORS_ORIGIN="https://your-site.netlify.app"
