# Backend environment variables.
# Copy this file to `.env` for local development.

# Postgres connection strings (get both from your Neon project dashboard).
#   DATABASE_URL -> pooled connection string (used at runtime; host contains "-pooler")
#   DIRECT_URL   -> direct connection string (used by `prisma migrate`)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign JWTs. Use a long, random value in production.
JWT_SECRET="change-me"

# Port the server listens on. Render injects its own PORT automatically.
PORT=3001
